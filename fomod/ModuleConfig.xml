<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>MorphSyncTogether 0.3.2</moduleName>
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="BodyHairSliders provider mods">
      <optionalFileGroups order="Explicit">
        <group name="Which BodyHairSliders provider mods do you use?" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="Pubic Hairstyles All In One CBBE / Pubes Forever Female">
              <description>Synchronizes female pubic overlays from Pubic Hairstyles All In One CBBE / Pubes Forever Female.</description>
              <files><folder source="10 Pubes Forever Female" destination="" priority="10" /></files>
              <typeDescriptor><dependencyType><defaultType name="Optional" /><patterns><pattern><dependencies operator="And"><fileDependency file="AK_RM_PubicStyles_All_In_One.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns></dependencyType></typeDescriptor>
            </plugin>
            <plugin name="Pubes Forever Male">
              <description>Synchronizes male pubic overlays from Pubes Forever Male.</description>
              <files><folder source="20 Pubes Forever Male" destination="" priority="20" /></files>
              <typeDescriptor><dependencyType><defaultType name="Optional" /><patterns><pattern><dependencies operator="And"><fileDependency file="AK_RM_PubicStyles_All_In_One_M.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns></dependencyType></typeDescriptor>
            </plugin>
            <plugin name="Natural Pubic Hairstyles">
              <description>Synchronizes the female pubic overlays provided by Natural Pubic Hairstyles.</description>
              <files><folder source="30 Natural Pubic Hairstyles" destination="" priority="30" /></files>
              <typeDescriptor><dependencyType><defaultType name="Optional" /><patterns><pattern><dependencies operator="And"><fileDependency file="NaturalPubicHairstyles.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns></dependencyType></typeDescriptor>
            </plugin>
            <plugin name="Natural Pubic Hairstyles - UBE">
              <description>Synchronizes the UBE pubic overlays provided by Natural Pubic Hairstyles - UBE.</description>
              <files><folder source="40 Natural Pubic Hairstyles UBE" destination="" priority="40" /></files>
              <typeDescriptor><dependencyType><defaultType name="Optional" /><patterns><pattern><dependencies operator="And"><fileDependency file="UBENaturalPubicHairstyles.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns></dependencyType></typeDescriptor>
            </plugin>
            <plugin name="More Pubes for SlaveTats">
              <description>Synchronizes the female pubic textures from More Pubes for SlaveTats. This provider has no plugin file, so detection uses one of its loose textures.</description>
              <files><folder source="50 More Pubes for SlaveTats" destination="" priority="50" /></files>
              <typeDescriptor><dependencyType><defaultType name="Optional" /><patterns><pattern><dependencies operator="And"><fileDependency file="textures\actors\character\slavetats\ZckeZckTPubicHair\ZckeZcktPubicA_1.dds" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns></dependencyType></typeDescriptor>
            </plugin>
            <plugin name="Nordic Warmaiden Body Hair">
              <description>Synchronizes Nordic Warmaiden pubic, armpit, stomach, butt and back hair overlays.</description>
              <files><folder source="60 Nordic Warmaiden" destination="" priority="60" /></files>
              <typeDescriptor><dependencyType><defaultType name="Optional" /><patterns><pattern><dependencies operator="And"><fileDependency file="Nordic Warmaiden Body Hair.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns></dependencyType></typeDescriptor>
            </plugin>
            <plugin name="HIMBO V3 Bodyhair Overlays for Racemenu">
              <description>Synchronizes the Body overlay regions provided by HIMBO V3 Bodyhair Overlays for Racemenu.</description>
              <files><folder source="70 HIMBO Bodyhair" destination="" priority="70" /></files>
              <typeDescriptor><dependencyType><defaultType name="Optional" /><patterns><pattern><dependencies operator="And"><fileDependency file="HIMBOBodyhairOverlay.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns></dependencyType></typeDescriptor>
            </plugin>
            <plugin name="OPubes NG compatibility bridge">
              <description>Enables synchronization of OPubes-compatible pubic overlays handled through the BodyHairSliders compatibility bridge.</description>
              <files><folder source="80 OPubes NG" destination="" priority="80" /></files>
              <typeDescriptor><dependencyType><defaultType name="Optional" /><patterns><pattern><dependencies operator="And"><fileDependency file="OPubes.esp" state="Active" /></dependencies><type name="Recommended" /></pattern></patterns></dependencyType></typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
