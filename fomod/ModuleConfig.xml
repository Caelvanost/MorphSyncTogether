<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>MorphSyncTogether 0.4.0</moduleName>
  <moduleImage path="fomod\ModuleImage.png" />
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Internet role">
      <optionalFileGroups order="Explicit">
        <group name="Which machine is this?" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Client / LAN / no Internet relay">
              <description>Default zero-config install. LAN discovery stays enabled, and remote Internet clients automatically reuse STR's saved direct-connect address when available.</description>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="Player1 host / Internet relay">
              <description>Use this only on the Skyrim Together host that forwards UDP 27992. It enables MorphSync relay mode; clients can still stay on the default zero-config profile.</description>
              <files>
                <folder source="20 Internet Relay Host" destination="" priority="20" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="OPubes integration">
      <optionalFileGroups order="Explicit">
        <group name="Do you use OPubes?" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="No - I do not use OPubes">
              <description>Installs BodyMorph and FaceGen makeup synchronization only. OPubes network capture is disabled.</description>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Recommended" />
                  <patterns>
                    <pattern>
                      <dependencies operator="Or">
                        <fileDependency file="OPubes.esp" state="Active" />
                        <fileDependency file="AK_RM_PubicStyles_All_In_One.esp" state="Active" />
                        <fileDependency file="AK_RM_PubicStyles_All_In_One_M.esp" state="Active" />
                      </dependencies>
                      <type name="Optional" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Yes - I use OPubes">
              <description>Also synchronizes the OPubes or OPubesRaceMenuSelector texture, tint, alpha, and shaved state. Install the same option on every client.</description>
              <files>
                <folder source="10 OPubes" destination="" priority="10" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="Or">
                        <fileDependency file="OPubes.esp" state="Active" />
                        <fileDependency file="AK_RM_PubicStyles_All_In_One.esp" state="Active" />
                        <fileDependency file="AK_RM_PubicStyles_All_In_One_M.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
