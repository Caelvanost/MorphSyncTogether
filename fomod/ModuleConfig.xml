<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>MorphSyncTogether 0.2.12</moduleName>
  <moduleImage path="fomod\ModuleImage.png" />
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Body hair overlay packs">
      <optionalFileGroups order="Explicit">
        <group name="Which body-hair overlay packs do you use?" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="Pubes Forever - Female">
              <description>Synchronizes female pubic overlays from Pubic Hairstyles All In One / Pubes Forever. Also enables compatible OPubes female pubic overlays.</description>
              <files>
                <folder source="10 Pubes Forever Female" destination="" priority="10" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="AK_RM_PubicStyles_All_In_One.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Pubes Forever - Male">
              <description>Synchronizes male pubic overlays from Pubes Forever for Males. Also enables compatible OPubes male pubic overlays.</description>
              <files>
                <folder source="20 Pubes Forever Male" destination="" priority="20" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="AK_RM_PubicStyles_All_In_One_M.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Nordic Warmaiden Body Hair">
              <description>Synchronizes Nordic Warmaiden pubic, armpit, stomach, butt and back hair overlays.</description>
              <files>
                <folder source="30 Nordic Warmaiden" destination="" priority="30" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Nordic Warmaiden Body Hair.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Bodyhair for HIMBO">
              <description>Synchronizes HIMBO arms, armpits, butt, back, stomach, chest and legs body-hair overlays.</description>
              <files>
                <folder source="40 HIMBO Bodyhair" destination="" priority="40" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="HIMBOBodyhairOverlay.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
